digraph ER {
    graph [rankdir=LR, fontname="DejaVu Sans", bgcolor="white", pad=0.4, nodesep=0.7, ranksep=1.3,
           label="Жатақхана бөлмелерін брондау жүйесі — ER-диаграмма", labelloc=t, fontsize=20];
    node  [shape=plaintext, fontname="DejaVu Sans", fontsize=12];
    edge  [fontname="DejaVu Sans", fontsize=11, color="#444444", arrowhead=crow, arrowtail=tee, dir=both];

    users [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2c5282">
      <TR><TD BGCOLOR="#2c5282" COLSPAN="2"><FONT COLOR="white"><B>users</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INT, PK</TD></TR>
      <TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
      <TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(100), UNIQUE</TD></TR>
      <TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
      <TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
      <TR><TD ALIGN="LEFT">gender</TD><TD ALIGN="LEFT">ENUM(male, female)</TD></TR>
      <TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">ENUM(student, admin)</TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
    </TABLE>>];

    dormitories [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#276749">
      <TR><TD BGCOLOR="#276749" COLSPAN="2"><FONT COLOR="white"><B>dormitories</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INT, PK</TD></TR>
      <TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
      <TR><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
      <TR><TD ALIGN="LEFT">gender_type</TD><TD ALIGN="LEFT">ENUM(male, female, mixed)</TD></TR>
      <TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
    </TABLE>>];

    rooms [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#975a16">
      <TR><TD BGCOLOR="#975a16" COLSPAN="2"><FONT COLOR="white"><B>rooms</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INT, PK</TD></TR>
      <TR><TD ALIGN="LEFT"><I>dormitory_id</I></TD><TD ALIGN="LEFT">INT, FK → dormitories</TD></TR>
      <TR><TD ALIGN="LEFT">room_number</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR>
      <TR><TD ALIGN="LEFT">floor</TD><TD ALIGN="LEFT">TINYINT</TD></TR>
      <TR><TD ALIGN="LEFT">capacity</TD><TD ALIGN="LEFT">TINYINT</TD></TR>
      <TR><TD ALIGN="LEFT">room_type</TD><TD ALIGN="LEFT">ENUM(single…quad)</TD></TR>
      <TR><TD ALIGN="LEFT">price_per_month</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM(available, maintenance)</TD></TR>
      <TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">TEXT</TD></TR>
    </TABLE>>];

    amenities [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#553c9a">
      <TR><TD BGCOLOR="#553c9a" COLSPAN="2"><FONT COLOR="white"><B>amenities</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INT, PK</TD></TR>
      <TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(50), UNIQUE</TD></TR>
    </TABLE>>];

    room_amenities [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#553c9a">
      <TR><TD BGCOLOR="#805ad5" COLSPAN="2"><FONT COLOR="white"><B>room_amenities</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B><I>room_id</I></B></TD><TD ALIGN="LEFT">INT, PK, FK → rooms</TD></TR>
      <TR><TD ALIGN="LEFT"><B><I>amenity_id</I></B></TD><TD ALIGN="LEFT">INT, PK, FK → amenities</TD></TR>
    </TABLE>>];

    bookings [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#c53030">
      <TR><TD BGCOLOR="#c53030" COLSPAN="2"><FONT COLOR="white"><B>bookings</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INT, PK</TD></TR>
      <TR><TD ALIGN="LEFT"><I>user_id</I></TD><TD ALIGN="LEFT">INT, FK → users</TD></TR>
      <TR><TD ALIGN="LEFT"><I>room_id</I></TD><TD ALIGN="LEFT">INT, FK → rooms</TD></TR>
      <TR><TD ALIGN="LEFT">start_date</TD><TD ALIGN="LEFT">DATE</TD></TR>
      <TR><TD ALIGN="LEFT">end_date</TD><TD ALIGN="LEFT">DATE</TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM(pending, approved,<BR/>rejected, cancelled)</TD></TR>
      <TR><TD ALIGN="LEFT">comment</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
      <TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
    </TABLE>>];

    dormitories -> rooms          [label="  1 : N  \n қамтиды", arrowtail=tee];
    users       -> bookings       [label="  1 : N  \n жасайды"];
    rooms       -> bookings       [label="  1 : N  \n брондалады"];
    rooms       -> room_amenities [label="  1 : N  "];
    amenities   -> room_amenities [label="  1 : N  "];

    { rank=same; users; dormitories; amenities; }
    { rank=same; rooms; }
    { rank=same; bookings; room_amenities; }
}
